# Meta Ads
META_ACCESS_TOKEN=seu_token_aqui
META_AD_ACCOUNT_ID=act_XXXXXXXXXX
META_APP_ID=seu_app_id
META_APP_SECRET=seu_app_secret

# Google Ads
GOOGLE_DEVELOPER_TOKEN=seu_developer_token
GOOGLE_CLIENT_ID=seu_client_id
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REFRESH_TOKEN=seu_refresh_token
GOOGLE_CUSTOMER_ID=XXXXXXXXXX

# Google Analytics 4
GA4_PROPERTY_ID=XXXXXXXXXX
GA4_SERVICE_ACCOUNT_KEY=seu_json_de_service_account

# TikTok Ads
TIKTOK_ACCESS_TOKEN=seu_token
TIKTOK_ADVERTISER_ID=XXXXXXXXXX

# WhatsApp BSP
WHATSAPP_BSP_TOKEN=seu_token
WHATSAPP_PHONE_NUMBER_ID=XXXXXXXXXX
WHATSAPP_BUSINESS_ACCOUNT_ID=XXXXXXXXXX

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
WEBHOOK_SECRET=seu_secret_aqui
NEXT_PUBLIC_APP_URL=https://seu-projeto.vercel.app

# Servidor MCP (/api/mcp) - permite chamar o Traffiq de outras IAs
# Gere uma chave longa: openssl rand -hex 32
TRAFFIQ_MCP_KEY=
# true libera meta_set_status e meta_set_daily_budget (alteram a conta)
TRAFFIQ_MCP_ALLOW_WRITES=false
# Opcional: URL usada para o servidor chamar as proprias rotas (padrao: host da requisicao)
TRAFFIQ_INTERNAL_URL=
# Google: com CLIENT_ID + CLIENT_SECRET + REFRESH_TOKEN (acima) o MCP renova o access token sozinho

# Agente (Assistente e Automacoes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
